{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "web"
      ],
      "port": 3000
    },
    {
      "name": "backend",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--experimental-strip-types",
        "--experimental-sqlite",
        "--no-warnings",
        "backend/src/cli.ts",
        "serve",
        "--port",
        "4000"
      ],
      "port": 4000
    },
    {
      "name": "newsroom",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "web",
        "--",
        "--port",
        "3100"
      ],
      "port": 3100,
      "env": {
        "NEWSROOM": "1",
        "NEXT_PUBLIC_BACKEND_URL": "http://127.0.0.1:4100"
      }
    },
    {
      "name": "engine-dev",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--experimental-strip-types",
        "--experimental-sqlite",
        "--no-warnings",
        "backend/src/cli.ts",
        "serve",
        "--port",
        "4100"
      ],
      "port": 4100
    }
  ]
}