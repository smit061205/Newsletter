{
  // The engine's own typecheck (npx tsc -p site/engine): it runs under Node on
  // GitHub, borrowing the app's code read-only, so it's checked apart from the
  // website's Next build (site/tsconfig.json leaves it out, as it does pipeline/).
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "types": ["node"],
    "typeRoots": ["../../node_modules/@types"]
  },
  "include": ["*.ts", "../lib/telegram.ts"]
}
